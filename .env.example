# ==============================================================================
# Smart Food Storage Monitoring Dashboard — Environment Configuration Template
# ==============================================================================
# Copy this template to create your local development configuration:
#   PowerShell:  Copy-Item .env.example .env.local
#   Bash:        cp .env.example .env.local
#
# CRITICAL SECURITY NOTICE:
# Variables prefixed with `VITE_` are embedded directly into client-side JavaScript
# bundles at build time and can be inspected by anyone using browser developer tools.
# This client-side integration is strictly for local demonstration and development.
# NEVER commit .env.local or real Blynk authentication tokens to version control.
# ==============================================================================

# Blynk Cloud Regional Host
# Specifies the target Blynk API server endpoint.
# Default: blynk.cloud
# Regional alternatives: fra1.blynk.cloud, lon1.blynk.cloud, ny3.blynk.cloud
VITE_BLYNK_SERVER=blynk.cloud

# Blynk Device Authentication Token
# Obtain this 32-character token from your Blynk Console (Device Info tab).
# Leave empty to run the dashboard in mock/demonstration mode.
VITE_BLYNK_AUTH_TOKEN=your_blynk_device_auth_token_here
